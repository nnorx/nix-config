# shellcheck shell=bash
# caffeinate, for tests/night-shift/run.sh: what awake runs on a Mac while an
# agent works. Logs {tool: "caffeinate", args, lock}, lock saying whether it
# was handed the run lock's descriptor, 9, to $NS_CASE/log.jsonl, and returns
# at once, rather than holding anything awake.
set -euo pipefail

lock=false
if { true >&9; } 2>/dev/null; then lock=true; fi
printf '%s\0' "$@" | jq -Rsc --argjson lock "$lock" \
  '{tool: "caffeinate", args: (split("\u0000") | .[:-1]), lock: $lock}' >>"$NS_CASE/log.jsonl"
