# shellcheck shell=bash
# osascript, for tests/night-shift/run.sh: notify() on a Mac, which passes the
# title and the message as the last two arguments to a run handler. Logs
# {tool: "notify", title, body, script} to $NS_CASE/log.jsonl, where script
# is everything before them, so a case can check that no text reached the
# script itself. Fails when the file notify-fail exists.
set -euo pipefail

args=("$@")
n=${#args[@]}
((n >= 2)) || exit 1
printf '%s\0' "${args[@]:0:n-2}" | jq -Rsc --arg t "${args[n - 2]}" --arg b "${args[n - 1]}" \
  '{tool: "notify", title: $t, body: $b, script: (split("\u0000") | .[:-1])}' >>"$NS_CASE/log.jsonl"
[[ ! -f $NS_CASE/notify-fail ]]
