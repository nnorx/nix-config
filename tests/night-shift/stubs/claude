# shellcheck shell=bash
# claude, for tests/night-shift/run.sh. Logs every call to $NS_CASE/log.jsonl
# as {tool: "claude", args, cwd}. `agents --json --all` prints the roster,
# $NS_CASE/roster.json, or [] without one. `--bg -n <name>` adds a running
# session to the roster, the way claude lists one it started, so the
# dispatcher's next look finds it. It fails when the file claude-fail
# exists, saying on stderr what the file holds, or a line of its own when
# it is empty; first it runs the script claude-before, when that exists,
# where it was called. `stop <id>` marks that session stopped, as claude's
# roster soon does; with the file stop-slow, the roster still lists it as
# before for the next two looks. rm and --resume only log. A call given
# --settings leaves a copy of them at $NS_CASE/settings-given.json, for a case
# to read once the caller has removed the file.
set -euo pipefail

dir=$NS_CASE
roster=$dir/roster.json
printf '%s\0' "$@" | jq -Rsc --arg cwd "$PWD" '{tool: "claude", args: (split("\u0000") | .[:-1]), cwd: $cwd}' >>"$dir/log.jsonl"
[[ -f $roster ]] || echo '[]' >"$roster"
for ((i = 1; i < $#; i++)); do
  [[ ${!i} != --settings ]] || { j=$((i + 1)); cp "${!j}" "$dir/settings-given.json"; }
done

case ${1-} in
  agents)
    cat "$roster"
    jq 'map(if .stopping then .stopping -= 1 | if .stopping == 0 then .state = "stopped" | del(.stopping) else . end else . end)' \
      "$roster" >"$roster.tmp"
    mv "$roster.tmp" "$roster"
    ;;
  stop)
    if [[ -f $dir/stop-slow ]]; then
      change='.stopping = 2'
    else
      change='.state = "stopped"'
    fi
    jq --arg id "${2-}" "map(if .id == \$id then $change else . end)" "$roster" >"$roster.tmp"
    mv "$roster.tmp" "$roster"
    ;;
  --bg)
    [[ ! -f $dir/claude-before ]] || "$BASH" "$dir/claude-before"
    [[ ! -f $dir/claude-fail ]] || {
      if [[ -s $dir/claude-fail ]]; then
        cat "$dir/claude-fail" >&2
      else
        echo "claude stub: told to fail" >&2
      fi
      exit 1
    }
    name=""
    while (($#)); do
      [[ $1 != -n ]] || name=$2
      shift
    done
    if [[ -n $name ]]; then
      n=$(($(jq length "$roster") + 1))
      jq --arg n "$n" --arg name "$name" --arg cwd "$PWD" \
        '. + [{id: "job-\($n)", sessionId: "session-\($n)", name: $name, cwd: $cwd, state: "running"}]' \
        "$roster" >"$roster.tmp"
      mv "$roster.tmp" "$roster"
    fi
    ;;
  --version) echo "0.0.0 (night-shift test stub)" ;;
esac
